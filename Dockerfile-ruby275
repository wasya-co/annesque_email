##
## This builds a ruby+nginx image.
##
##   docker build . -f Dockerfile-ruby275    -t piousbox/ruby275:0.0.17
##   docker push piousbox/ruby275:0.0.17
##

FROM debian:bookworm

RUN apt-get update && \
  apt-get install -y \
    cron curl \
    git gnupg2 \
    imagemagick iputils-ping \
    lsof \
    net-tools \
    screen silversearcher-ag \
    telnet \
    vim \
    wget \
    unzip

RUN apt install -y \
  build-essential \
  libz-dev libcurl4-openssl-dev libssl-dev \
  nodejs \
  procps \
  tree

COPY ./root/_bashrc   /root/.bashrc
COPY ./root/_screenrc /root/.screenrc

RUN git clone https://github.com/rbenv/rbenv.git      /opt/rbenv ; \
  git   clone https://github.com/rbenv/ruby-build.git /opt/rbenv/plugins/ruby-build ; \
  . /root/.bashrc ; \
  /opt/rbenv/bin/rbenv install 2.7.5 ; \
  echo "2.7.5" > /opt/projects/.ruby-version ; \
  echo ok

RUN . /root/.bashrc ; \
  cd /opt/projects ; \
  gem install passenger --no-document ; \
  passenger-install-nginx-module --auto ; \
  echo ok


RUN apt install -y \
  libyaml-dev

RUN apt update && apt install -y \
    python3 \
    python3-dev \
    make \
    g++ \
    build-essential

ENV PYTHON=/usr/bin/python3

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt install -y nodejs

RUN npm install -g yarn

WORKDIR /opt/projects/packagedapp

EXPOSE 80
EXPOSE 9002

