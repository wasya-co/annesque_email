## syntax=docker/dockerfile:1
##
## This builds a ruby+nginx image.
##
##   docker build . -f Dockerfile-ruby275    -t piousbox/ruby275-nginx:0.0.19
##   docker push piousbox/ruby275-nginx:0.0.19
##
##  clean docker:
##    docker builder prune -af


FROM debian:bookworm

RUN apt-get update && \
  apt-get install -y \
    cron curl \
    git gnupg2 \
    imagemagick iputils-ping \
    libyaml-dev lsof \
    net-tools \
    screen silversearcher-ag \
    telnet \
    vim \
    wget \
    unzip

RUN apt install -y \
  build-essential \
  libz-dev libcurl4-openssl-dev libssl-dev \
  nodejs \
  procps \
  tree

COPY ./root/_bashrc   /root/.bashrc
COPY ./root/_screenrc /root/.screenrc

RUN git clone https://github.com/rbenv/rbenv.git      /opt/rbenv ; \
  git   clone https://github.com/rbenv/ruby-build.git /opt/rbenv/plugins/ruby-build ; \
  . /root/.bashrc ; \
  /opt/rbenv/bin/rbenv install 2.7.5 ; \
  echo "2.7.5" > /opt/projects/.ruby-version ; \
  echo ok

RUN . /root/.bashrc ; \
  cd /opt/projects ; \
  gem install passenger --no-document ; \
  passenger-install-nginx-module --auto ; \
  echo ok

RUN apt update && apt install -y \
    python3 \
    python3-dev \
    make \
    g++ \
    build-essential
RUN ln -s /usr/bin/python3 /usr/local/bin/python

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt install -y nodejs

RUN apt update && apt install -y \
    pkg-config \
    build-essential \
    libx11-dev \
    libxi-dev \
    libxext-dev \
    libx11-xcb-dev \
    libxkbfile-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev

RUN npm install -g yarn


# Chrome dependencies
RUN apt clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
RUN apt update && apt install -y \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*
# Install Google Chrome
RUN wget -qO- https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list \
    && apt update \
    && apt install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome


WORKDIR /opt/projects/packagedapp

EXPOSE 80
EXPOSE 9002

